# Copy to .env and fill in what you have. Everything is optional; the site runs in preview mode without keys.

PORT=3000
# Public address of the site, used for Stripe return links (e.g. https://iainfindlay.com)
PUBLIC_URL=http://localhost:3000

# Muso.ai developer API key (msk_...), from https://platform.muso.ai
# Without it the site serves the verified top 30 credits from data/muso-snapshot.json.
MUSO_API_KEY=

# Stripe secret key (sk_live_... or sk_test_...) and webhook signing secret (whsec_...)
# Webhook endpoint to add in the Stripe dashboard: https://YOUR-DOMAIN/api/stripe/webhook  (event: checkout.session.completed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Twitch app credentials from https://dev.twitch.tv/console for real live status
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Password for the admin dashboard at /admin (required to sign in)
ADMIN_PASSWORD=
# Optional: token for scripts calling admin endpoints (x-admin-token header)
ADMIN_TOKEN=

# Set to production when deployed. Hides the "Preview live state" switch unless ALLOW_STREAM_SIMULATION=1
NODE_ENV=development
# APPLE_ENRICH=off   turns off Apple artwork and preview matching

# Email (Resend, free tier): new request alerts to you, replies and proposals to clients
RESEND_API_KEY=
# Sender address on a domain you've verified in Resend, e.g. Iain Findlay <iain@yourdomain.com>
MAIL_FROM=
# Where new requests and client messages are sent
ADMIN_EMAIL=
